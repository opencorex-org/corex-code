{
  "name": "corex-code",
  "version": "0.1.0",
  "description": "A local-first AI coding agent with safe, reviewable edits.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "local-first",
    "ollama"
  ],
  "homepage": "https://github.com/lahiruudayakumara/corex-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahiruudayakumara/corex-code.git"
  },
  "bugs": {
    "url": "https://github.com/lahiruudayakumara/corex-code/issues"
  },
  "files": [
    "dist/corex.js",
    "README.md",
    "LICENSE",
    "corex.config.example.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.5",
  "bin": {
    "corex": "./dist/corex.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/corex.js --external=react-devtools-core",
    "build:binary": "bun build src/cli.ts --compile --outfile=dist/corex --external=react-devtools-core",
    "hashes": "bun run scripts/generate-hashes.ts",
    "hashes:verify": "bun run scripts/generate-hashes.ts --verify",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "check": "bun run typecheck && bun run lint && bun test && bun run build",
    "pack:check": "bun run build && bun run scripts/package-pack-check.ts",
    "smoke:package": "bun run scripts/package-smoke.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run smoke:package"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "diff": "^8.0.2",
    "ink": "^8.0.0",
    "ollama": "^0.6.3",
    "react": "^19.3.1",
    "react-devtools-core": "^8.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/react": "^19.3.0",
    "oxlint": "^1.27.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
